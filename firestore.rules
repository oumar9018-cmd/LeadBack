rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCeo() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ceo';
    }

    // Batch 3 — workspace membership. Members are keyed by their Firebase
    // uid under the OWNER's doc so rules can enforce permissions with a
    // single get() (rules cannot query). Every member rule starts with
    // exists() because get() on a missing doc fails closed.
    function isWorkspaceMember(ownerId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid));
    }

    function memberRole(ownerId) {
      return get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.role;
    }

    function memberBranch(ownerId) {
      return get(/databases/$(database)/documents/users/$(ownerId)/members/$(request.auth.uid)).data.branchId;
    }

    function isWorkspaceAdmin(ownerId) {
      return isOwner(ownerId) ||
        (isWorkspaceMember(ownerId) && memberRole(ownerId) == 'admin');
    }

    function isBranchManager(ownerId) {
      return isWorkspaceMember(ownerId) && memberRole(ownerId) == 'branch_manager';
    }

    function isSalesRep(ownerId) {
      return isWorkspaceMember(ownerId) && memberRole(ownerId) == 'sales_rep';
    }

    function subscriptionFields() {
      return [
        'subscriptionStatus',
        'plan',
        'trialRedeemed',
        'trialStartedAt',
        'trialEndsAt',
        'subscriptionStartedAt',
        'subscriptionPeriodStartedAt',
        'subscriptionEndsAt',
        'lastPaymentAt',
        'lastPaymentAmount',
        'lastPaymentCurrency',
        'razorpayOrderId',
        'razorpayPaymentId'
      ];
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isCeo();
      allow list: if isCeo();

      // New accounts can only create a customer profile. Entitlement and role
      // fields are written by trusted server code, never by the browser.
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'customer' &&
        !request.resource.data.keys().hasAny(subscriptionFields());

      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'name', 'email', 'displayName', 'photoURL', 'updatedAt'
        ]);
      allow delete: if false;

      // Batch 3 — role-scoped inquiry access. Owner + admins: everything.
      // Branch managers: only rows in their branch, and they cannot move
      // a row to another branch or reassign it. Sales reps: only rows
      // assigned to them, and they cannot reassign. Delete: owner/admins.
      // Unassigned / unbranched rows are visible to admins only (safe
      // default — old inquiries have empty assignedTo/branchId).
      match /inquiries/{inquiryId} {
        allow read: if isOwner(userId) || isWorkspaceAdmin(userId) ||
          (isBranchManager(userId) &&
            resource.data.get('branchId', '') == memberBranch(userId)) ||
          (isSalesRep(userId) &&
            resource.data.get('assignedTo', '') == request.auth.uid);
        allow create: if isOwner(userId) || isWorkspaceAdmin(userId) ||
          (isBranchManager(userId) &&
            request.resource.data.get('branchId', '') == memberBranch(userId));
        allow update: if isOwner(userId) || isWorkspaceAdmin(userId) ||
          (isBranchManager(userId) &&
            resource.data.get('branchId', '') == memberBranch(userId) &&
            request.resource.data.get('branchId', '') == resource.data.get('branchId', '')) ||
          (isSalesRep(userId) &&
            resource.data.get('assignedTo', '') == request.auth.uid &&
            request.resource.data.get('assignedTo', '') == resource.data.get('assignedTo', ''));
        allow delete: if isOwner(userId) || isWorkspaceAdmin(userId);
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId) || isWorkspaceAdmin(userId) ||
          isBranchManager(userId);
        allow write: if isOwner(userId) || isWorkspaceAdmin(userId);
      }

      // Batch 3 — team invites. Doc id is the lowercased email so the
      // invited member can find it from their own Google token email.
      // Batch 4 — the invitee may make exactly ONE change themselves:
      // pending -> accepted, at accept time. Nothing else about the
      // invite (role, branch) is ever writable by the invitee.
      match /invites/{inviteId} {
        allow get: if isOwner(userId) || isWorkspaceAdmin(userId) ||
          (signedIn() && resource.data.email == request.auth.token.email);
        allow list: if isOwner(userId) || isWorkspaceAdmin(userId);
        allow create, update, delete: if isOwner(userId) || isWorkspaceAdmin(userId);
        allow update: if signedIn() &&
          resource.data.email == request.auth.token.email &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }

      // Batch 3 — team members, keyed by member uid. Accept flow
      // (phase 2): the member creates their own record only when a
      // pending invite exists for their token email with the same role.
      // Owners never hand-write member docs, and members can never
      // grant themselves a role.
      match /members/{memberId} {
        allow get: if isOwner(userId) || isWorkspaceAdmin(userId) ||
          request.auth.uid == memberId || isCeo();
        allow list: if isOwner(userId) || isWorkspaceAdmin(userId) || isCeo();
        allow create: if signedIn() && request.auth.uid == memberId &&
          exists(/databases/$(database)/documents/users/$(userId)/invites/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/users/$(userId)/invites/$(request.auth.token.email)).data.status == 'pending' &&
          get(/databases/$(database)/documents/users/$(userId)/invites/$(request.auth.token.email)).data.role == request.resource.data.role;
        allow update: if isOwner(userId) || isWorkspaceAdmin(userId);
        // Batch 5 — a member may toggle ONLY their own routing
        // availability (and, for admins, whether they take routed
        // leads). Role, branch, assignedCount and every other field
        // stay owner/admin-only, so nobody can self-promote or pad
        // their own load count.
        allow update: if request.auth.uid == memberId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available', 'takesLeads']);
        allow delete: if isOwner(userId) || isWorkspaceAdmin(userId);
      }

      // Batch 3 — membership mirrors (member's own doc, keyed by owner).
      // Role in the mirror must always match the members doc, so a
      // member cannot forge a higher role for themselves.
      // Batch 4 — members need to LIST their own mirrors to resolve
      // their workspace (they do not know the owner's uid in advance);
      // and the workspace owner/admins need to update/delete the
      // mirror when they change a role or remove a member, so the
      // mirror can never go stale.
      match /memberships/{workspaceOwnerId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(workspaceOwnerId)/members/$(userId)) &&
          get(/databases/$(database)/documents/users/$(workspaceOwnerId)/members/$(userId)).data.role == request.resource.data.role;
        allow update: if (isOwner(userId) || isWorkspaceAdmin(workspaceOwnerId)) &&
          exists(/databases/$(database)/documents/users/$(workspaceOwnerId)/members/$(userId)) &&
          get(/databases/$(database)/documents/users/$(workspaceOwnerId)/members/$(userId)).data.role == request.resource.data.role;
        allow delete: if isOwner(userId) || isWorkspaceAdmin(workspaceOwnerId);
      }

      // Batch 3 — audit log: append-only. Owner/admins (+CEO) read; any
      // workspace actor may append their own actions; NOBODY may update
      // or delete a record, not even the owner.
      match /audit/{auditId} {
        allow get, list: if isOwner(userId) || isWorkspaceAdmin(userId) || isCeo();
        allow create: if (isOwner(userId) || isWorkspaceMember(userId)) &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.action in ['status_changed', 'member_added', 'member_removed', 'member_role_changed', 'export'];
        allow update, delete: if false;
      }
    }

    // Batch 4 — invite index: the one narrow public lookup the accept
    // flow needs. Invites live under the OWNER's uid, which the
    // invited member does not know, so the owner writes one index doc
    // per invite: inviteIndex/{emailLower} = { ownerUid, email }.
    // Get is allowed only when the caller's token email matches the
    // doc's email; listing is never allowed, so nobody can enumerate
    // who was invited. Only the workspace owner/admins may write it,
    // and the invitee may delete their own entry at accept time.
    match /inviteIndex/{emailLower} {
      allow get: if signedIn() &&
        resource.data.email == request.auth.token.email;
      allow list: if false;
      allow create, update: if signedIn() &&
        (request.resource.data.ownerUid == request.auth.uid ||
          isWorkspaceAdmin(request.resource.data.ownerUid));
      allow delete: if signedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
          isWorkspaceAdmin(resource.data.ownerUid) ||
          resource.data.email == request.auth.token.email);
    }

    // Razorpay order state is server-only. Cloud Functions Admin SDK bypasses
    // these client rules after payment verification.
    match /razorpayOrders/{orderId} {
      allow read, write: if false;
    }

    // Second-chance offers: public page (/o/{code}) needs unauthenticated
    // reads; view/claim tracking allows narrow public updates.
    match /offers/{offerId} {
      // Anyone with the link can view the offer.
      allow get: if true;
      // Owners can list their own offers.
      allow list: if signedIn() && request.auth.uid == resource.data.ownerUid;
      // Owners create offers stamped with their uid.
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      // Owners have full control over their offers.
      allow update: if signedIn() && request.auth.uid == resource.data.ownerUid;
      // Public can only move sent -> viewed -> redeemed and bump counters.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'viewedAt', 'views', 'redeemedAt']) &&
        resource.data.status in ['sent', 'viewed'] &&
        request.resource.data.status in ['viewed', 'redeemed'];
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    // Public booking pages (/b/{slug}): the business record contains only
    // public listing info (name, slug, services, hours), so anyone with a
    // link can look it up. Only the owning business may write it.
    match /businesses/{businessId} {
      allow get, list: if true;
      allow create, update: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() &&
        resource.data.ownerUid == request.auth.uid;

      // Booking requests: anyone with the link can create one; only the
      // owning business can read them.
      match /bookings/{bookingId} {
        allow create: if request.resource.data.keys().hasAll(
            ['customerName', 'customerPhone', 'preferredDate', 'status']) &&
          request.resource.data.status == 'pending';
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
        allow update, delete: if signedIn() &&
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
