:root {
  --app-bg: #f6f8fc;
  --app-card: #ffffff;
  --app-border: #e7ebf2;
  --app-text: #101828;
  --app-muted: #667085;
  --app-blue: #155eef;
  --app-blue-soft: #eef4ff;
  --app-green: #079455;
  --app-green-soft: #ecfdf3;
  --app-orange: #dc6803;
  --app-orange-soft: #fff7ed;
  --app-red: #d92d20;
  --app-red-soft: #fef3f2;
  font-family: 'DM Sans', Inter, system-ui, sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--app-bg);
  color: var(--app-text);
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  min-height: 100vh;
  display: flex;
}

.app-sidebar {
  width: 248px;
  flex: 0 0 248px;
  background: #fff;
  border-right: 1px solid var(--app-border);
  padding: 25px 16px;
  display: flex;
  flex-direction: column;
}

.app-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 19px;
  font-weight: 800;
  padding: 0 10px 30px;
}

.brand-mark {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  background: #155eef;
  color: #fff;
  font-weight: 800;
}

.side-nav {
  display: grid;
  gap: 5px;
}

.side-link {
  text-decoration: none;
  color: #667085;
  padding: 11px 13px;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 600;
}

.side-link:hover,
.side-link.active {
  background: #f1f5ff;
  color: #155eef;
}

.sidebar-bottom {
  margin-top: auto;
}

.business-mini {
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 14px 10px;
  border-top: 1px solid var(--app-border);
  margin-bottom: 10px;
}

.business-avatar {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: #eef4ff;
  color: #155eef;
  font-size: 11px;
  font-weight: 800;
}

.business-mini strong,
.business-mini span {
  display: block;
}

.business-mini strong {
  font-size: 12px;
}

.business-mini span {
  color: var(--app-muted);
  font-size: 11px;
  margin-top: 2px;
}

.logout {
  display: block;
}

.app-main {
  flex: 1;
  min-width: 0;
  padding: 38px 42px;
}

.app-header {
  display: flex;
  justify-content: space-between;
  gap: 25px;
  align-items: flex-start;
  margin-bottom: 30px;
}

.app-eyebrow {
  display: block;
  color: #667085;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
  margin-bottom: 7px;
}

.app-header h1 {
  font-size: 30px;
  letter-spacing: -.04em;
  margin: 0;
}

.app-header p {
  margin: 7px 0 0;
  color: var(--app-muted);
  font-size: 14px;
}

.header-actions {
  display: flex;
  gap: 9px;
}

.range-button,
.primary-action {
  border: 1px solid var(--app-border);
  background: #fff;
  border-radius: 9px;
  padding: 10px 13px;
  font-size: 13px;
  font-weight: 700;
}

.primary-action {
  background: var(--app-blue);
  border-color: var(--app-blue);
  color: white;
  box-shadow: 0 3px 8px rgba(21, 94, 239, .16);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}

.stat-card {
  background: var(--app-card);
  border: 1px solid var(--app-border);
  border-radius: 14px;
  padding: 19px;
  min-height: 135px;
}

.stat-primary {
  border-color: #cddcff;
  background: linear-gradient(145deg, #f9fbff, #eef4ff);
}

.stat-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--app-muted);
  font-size: 12px;
  font-weight: 700;
}

.stat-icon {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  background: #f2f4f7;
  color: #475467;
  font-weight: 800;
}

.stat-primary .stat-icon {
  background: #dbe7ff;
  color: var(--app-blue);
}

.stat-card strong {
  display: block;
  font-size: 27px;
  letter-spacing: -.04em;
  margin-top: 14px;
}

.stat-card small {
  color: var(--app-muted);
  display: block;
  font-size: 11px;
  margin-top: 4px;
}

.workspace-card,
.mini-panel {
  background: #fff;
  border: 1px solid var(--app-border);
  border-radius: 14px;
}

.workspace-card {
  overflow: hidden;
}

.workspace-heading {
  padding: 22px 23px 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.workspace-heading h2,
.panel-heading h3 {
  margin: 0;
  font-size: 18px;
  letter-spacing: -.02em;
}

.demo-label {
  border: 1px solid #d0d5dd;
  border-radius: 20px;
  color: #667085;
  padding: 5px 9px;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .08em;
}

.toolbar {
  padding: 0 23px 17px;
  display: flex;
  gap: 14px;
  justify-content: space-between;
  border-bottom: 1px solid var(--app-border);
}

.search-box {
  width: 290px;
  border: 1px solid var(--app-border);
  border-radius: 9px;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 11px;
}

.search-box span {
  color: #98a2b3;
}

.search-box input {
  width: 100%;
  border: 0;
  outline: 0;
  padding: 10px 0;
  font-size: 12px;
}

.filter-row {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.filter-button {
  border: 0;
  background: transparent;
  color: #667085;
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 11px;
  font-weight: 700;
}

.filter-button.selected {
  background: #eef4ff;
  color: #155eef;
}

.table-head,
.table-row {
  display: grid;
  grid-template-columns: 1.5fr 1.25fr .8fr .9fr 1fr;
  align-items: center;
  gap: 15px;
  padding: 0 23px;
}

.table-head {
  min-height: 42px;
  color: #98a2b3;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.table-row {
  min-height: 72px;
  border-top: 1px solid #f0f2f5;
  font-size: 12px;
}

.customer-cell {
  display: flex;
  gap: 10px;
  align-items: center;
}

.customer-avatar,
.queue-avatar {
  flex: 0 0 auto;
  width: 35px;
  height: 35px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: #f1f5ff;
  color: #155eef;
  font-weight: 800;
}

.customer-cell strong,
.customer-cell span {
  display: block;
}

.customer-cell strong {
  font-size: 12px;
}

.customer-cell span,
.service-cell {
  color: #667085;
  font-size: 11px;
  margin-top: 3px;
}

.value-cell {
  font-size: 12px;
}

.status {
  width: max-content;
  border-radius: 20px;
  padding: 5px 8px;
  font-size: 10px;
  font-weight: 800;
}

.status-new {
  background: #f2f4f7;
  color: #475467;
}

.status-followup {
  background: var(--app-orange-soft);
  color: var(--app-orange);
}

.status-replied {
  background: var(--app-blue-soft);
  color: var(--app-blue);
}

.status-recovered {
  background: var(--app-green-soft);
  color: var(--app-green);
}

.status-lost {
  background: var(--app-red-soft);
  color: var(--app-red);
}

.row-actions button,
.queue-item button {
  border: 1px solid #d0d5dd;
  background: #fff;
  border-radius: 7px;
  padding: 7px 9px;
  font-size: 10px;
  font-weight: 800;
  color: #344054;
}

.row-actions button:hover,
.queue-item button:hover {
  border-color: #b4c7f8;
  color: var(--app-blue);
}

.completed {
  color: var(--app-green);
  font-size: 10px;
  font-weight: 800;
}

.empty-state {
  padding: 50px 20px;
  text-align: center;
  color: var(--app-muted);
  font-size: 13px;
}

.bottom-grid {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 18px;
  margin-top: 18px;
}

.mini-panel {
  padding: 20px;
}

.panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18px;
}

.panel-heading > span {
  font-size: 10px;
  color: #667085;
  background: #f2f4f7;
  border-radius: 20px;
  padding: 5px 8px;
}

.queue-item {
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid #f0f2f5;
  padding: 12px 0;
}

.queue-item > div:nth-child(2) {
  flex: 1;
}

.queue-item strong,
.queue-item span {
  display: block;
}

.queue-item strong {
  font-size: 12px;
}

.queue-item span {
  color: #667085;
  font-size: 10px;
  margin-top: 2px;
}

.revenue-number {
  font-size: 34px;
  font-weight: 800;
  letter-spacing: -.05em;
  margin-top: 15px;
}

.mini-panel p {
  color: #667085;
  font-size: 12px;
  margin: 6px 0 22px;
}

.revenue-bar {
  height: 7px;
  background: #eef2f6;
  border-radius: 10px;
  overflow: hidden;
}

.revenue-bar span {
  height: 100%;
  display: block;
  background: #155eef;
  border-radius: inherit;
}

.revenue-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12px;
  color: #667085;
  font-size: 10px;
}

.revenue-meta strong {
  color: #101828;
}

.app-footer {
  display: flex;
  justify-content: space-between;
  color: #98a2b3;
  font-size: 10px;
  padding: 25px 2px 5px;
}

@media (max-width: 1100px) {
  .app-sidebar {
    width: 205px;
    flex-basis: 205px;
  }

  .app-main {
    padding: 30px 24px;
  }

  .stat-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .table-head,
  .table-row {
    grid-template-columns: 1.4fr 1.1fr .7fr .8fr 1fr;
  }
}

@media (max-width: 800px) {
  .app-shell {
    display: block;
  }

  .app-sidebar {
    width: 100%;
    height: auto;
    padding: 14px 16px;
    border-right: 0;
    border-bottom: 1px solid var(--app-border);
  }

  .app-logo {
    padding: 0 4px 12px;
  }

  .side-nav {
    display: flex;
    overflow-x: auto;
  }

  .side-link {
    white-space: nowrap;
  }

  .sidebar-bottom {
    display: none;
  }

  .app-main {
    padding: 24px 16px;
  }

  .app-header {
    display: block;
  }

  .header-actions {
    margin-top: 18px;
  }

  .stat-grid {
    grid-template-columns: 1fr 1fr;
  }

  .toolbar {
    display: block;
  }

  .search-box {
    width: 100%;
    margin-bottom: 10px;
  }

  .filter-row {
    justify-content: flex-start;
    overflow-x: auto;
    flex-wrap: nowrap;
  }

  .table-head {
    display: none;
  }

  .table-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 9px;
    padding: 15px;
  }

  .service-cell {
    grid-column: 1;
  }

  .value-cell {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .status {
    grid-column: 1;
  }

  .row-actions {
    grid-column: 2;
    grid-row: 3;
  }

  .bottom-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {
  .app-main {
    padding: 20px 12px;
  }

  .app-header h1 {
    font-size: 25px;
  }

  .header-actions {
    width: 100%;
  }

  .range-button,
  .primary-action {
    flex: 1;
  }

  .stat-grid {
    gap: 8px;
  }

  .stat-card {
    padding: 14px;
    min-height: 120px;
  }

  .stat-card strong {
    font-size: 22px;
  }

  .workspace-heading {
    padding: 18px 15px 14px;
  }

  .toolbar {
    padding: 0 15px 13px;
  }

  .table-row {
    padding: 14px 15px;
  }

  .app-footer {
    display: block;
    line-height: 1.8;
  }
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(16, 24, 40, .42);
  display: grid;
  place-items: center;
  padding: 18px;
}

.inquiry-modal {
  width: min(100%, 520px);
  background: #fff;
  border: 1px solid var(--app-border);
  border-radius: 18px;
  padding: 25px;
  box-shadow: 0 24px 70px rgba(16, 24, 40, .2);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.modal-header h2 {
  margin: 0;
  font-size: 23px;
  letter-spacing: -.035em;
}

.modal-header p {
  color: var(--app-muted);
  font-size: 12px;
  margin: 6px 0 0;
}

.modal-close {
  width: 34px;
  height: 34px;
  border: 1px solid var(--app-border);
  background: #fff;
  border-radius: 9px;
  font-size: 22px;
  line-height: 1;
  color: #667085;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
}

.form-grid label {
  display: grid;
  gap: 7px;
  color: #344054;
  font-size: 11px;
  font-weight: 800;
}

.form-grid input,
.form-grid select {
  width: 100%;
  border: 1px solid #d0d5dd;
  border-radius: 9px;
  background: #fff;
  outline: none;
  padding: 11px 12px;
  color: #101828;
  font-size: 12px;
}

.form-grid input:focus,
.form-grid select:focus {
  border-color: #84a9ff;
  box-shadow: 0 0 0 3px #eef4ff;
}

.full-field {
  grid-column: 1 / -1;
}

.money-input {
  display: flex;
  align-items: center;
  border: 1px solid #d0d5dd;
  border-radius: 9px;
  overflow: hidden;
}

.money-input span {
  padding-left: 12px;
  color: #667085;
}

.money-input input {
  border: 0;
  box-shadow: none;
}

.form-error {
  margin-top: 15px;
  padding: 10px 12px;
  border-radius: 8px;
  background: var(--app-red-soft);
  color: var(--app-red);
  font-size: 11px;
  font-weight: 700;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 23px;
}

.cancel-button,
.save-button {
  border-radius: 9px;
  padding: 10px 15px;
  font-size: 12px;
  font-weight: 800;
}

.cancel-button {
  border: 1px solid #d0d5dd;
  background: #fff;
  color: #344054;
}

.save-button {
  border: 1px solid var(--app-blue);
  background: var(--app-blue);
  color: #fff;
}

@media (max-width: 520px) {
  .inquiry-modal {
    padding: 20px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .full-field {
    grid-column: auto;
  }
}
